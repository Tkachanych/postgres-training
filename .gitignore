# Зависимости (52+ МБ, восстанавливаются установкой)
node_modules/

# Локальное окружение и секреты
.env
.env.*
!.env.example

# Логи и временные файлы
*.log
*.tmp
*.bak

# Кэш Python на случай вспомогательных скриптов
__pycache__/
*.pyc
.venv/

# Мусор ОС
Thumbs.db
desktop.ini
.DS_Store

# Резервная копия локальных файлов до объединения
/.merge-backup/
